# Copie este arquivo para .env e substitua todos os valores de exemplo.
# O arquivo .env e as senhas reais nao devem ser enviados ao Git.
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-longa
MYSQL_DATABASE=atividade_db
MYSQL_APP_USER=app_usuario
MYSQL_APP_PASSWORD=troque-por-uma-senha-da-aplicacao-longa

# Portas para uso local/LAN. Para publicacao na Internet use 80 e 443.
HTTP_PORT=8081
HTTPS_PORT=8443

# Para HTTPS publico, informe seu dominio real, por exemplo: app.exemplo.com
# Em desenvolvimento, localhost usa certificado local do Caddy.
DOMAIN=localhost
